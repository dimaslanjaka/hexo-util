    "html-entities": "^2.3.3",
    "html-tag-validator": "^1.6.0",
    "mocha": "^11.7.1",
    "rewire": "^9.0.0",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.0.3"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "cross-spawn": "^7.0.3",
    "highlight.js": "^11.6.0",
    "htmlparser2": "^10.0.0",
    "prismjs": "^1.29.0",
