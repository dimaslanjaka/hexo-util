  "scripts": {
    "build-cjs": "tsc -p tsconfig.cjs.json",
    "build-esm": "tsc -p tsconfig.esm.json",
    "build-dts": "tsc --emitDeclarationOnly --noEmit false --declaration --outDir dist",
    "build-exports": "node scripts/build_exports.mjs",
    "build-hightlight": "node scripts/build_highlight_alias.mjs",
    "build": "npm run build-hightlight && node build.js && npm run build-exports && npm run build-dts",
    "clean": "npx --yes rimraf dist tmp",
    "prepublishOnly": "npm install && npm run clean && npm run build",
    "lint": "eslint --config eslint.config.mjs lib test",
    "lint-fix": "npm run lint -- --fix",
    "pretest": "node scripts/pretest.mjs",
    "test": "mocha --loader=ts-node/esm --project tsconfig.mocha.json",
    "test-cov": "c8 --reporter=lcovonly npm run test",
    "postinstall": "npm run build-hightlight",
    "watch": "npx -y nodemon --delay 3 --ignore lib/highlight_alias.ts --watch build.js --watch lib --ext js,ts --exec \"yarn build > build.log 2>&1 && yarn workspace hexo-site run build\""
  },
  "files": [
    "dist/**",
    "scripts/",
    "highlight_alias.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexojs/hexo-util.git"
  },
  "homepage": "https://hexo.io/",
  "keywords": [
    "hexo",
    "util",
    "utilities"
  ],
  "author": "Tommy Chen <tommy351@gmail.com> (https://zespia.tw)",
  "maintainers": [
    "Abner Chou <hi@abnerchou.me> (https://abnerchou.me)"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
