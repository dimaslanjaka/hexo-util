{
  "name": "hexo-util",
  "version": "4.0.0",
  "description": "Utilities for Hexo.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build-cjs": "tsc -p tsconfig.cjs.json",
    "build-esm": "tsc -p tsconfig.esm.json",
    "build-dts": "tsc --emitDeclarationOnly --noEmit false --declaration --outDir dist",
    "build-exports": "node scripts/build_exports.mjs",
    "build-hightlight": "node scripts/build_highlight_alias.mjs",
    "build": "npm run build-hightlight && node build.js && npm run build-exports && npm run build-dts",
    "clean": "npx --yes rimraf dist tmp",
    "prepublishOnly": "npm install && npm run clean && npm run build",
    "lint": "eslint --config eslint.config.mjs lib test",
    "lint-fix": "npm run lint -- --fix",
    "pretest": "node scripts/pretest.mjs",
    "test": "mocha --loader=ts-node/esm --project tsconfig.mocha.json",
    "test-all": "npm run test -- ./test/**/*.spec.ts",
    "test-cov": "c8 --reporter=lcovonly npm run test-all",
    "postinstall": "npm run build-hightlight",
    "watch": "npx -y nodemon --delay 3 --ignore lib/highlight_alias.ts --watch build.js --watch lib --ext js,ts --exec \"yarn build > build.log 2>&1 && yarn workspace hexo-site run build\"",
    "pack": "npx -y tarball-packer --yarn --filename hexo-util --normalize-resolutions",
    "prepare": "husky"
  },
  "files": [
    "dist/**",
    "scripts/",
    "highlight_alias.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexojs/hexo-util.git"
  },
  "homepage": "https://hexo.io/",
  "keywords": [
    "hexo",
    "util",
    "utilities"
  ],
  "author": "Tommy Chen <tommy351@gmail.com> (https://zespia.tw)",
  "maintainers": [
    "Abner Chou <hi@abnerchou.me> (https://abnerchou.me)"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@types/babel__core": "^7",
    "@types/babel__preset-env": "^7",
    "@types/chai": "^4.3.11",
    "@types/cross-spawn": "^6.0.2",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.1.0",
    "@types/prismjs": "^1.26.0",
    "@types/rewire": "^2.5.30",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.55.0",
    "binary-collections": "^2.0.10",
    "c8": "^10.1.2",
    "chai": "^4.3.6",
    "domhandler": "^5.0.3",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "eslint": "^9.39.1",
    "eslint-config-hexo": "^6.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import": "^2.32.0",
    "highlightjs-solidity": "^2.0.6",
    "html-entities": "^2.3.3",
    "html-validate": "^11.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^11.7.5",
    "prettier": "^3.9.10",
    "rewire": "^9.0.1",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cross-spawn": "^7.0.3",
    "highlight.js": "^11.6.0",
    "htmlparser2": "^10.0.0",
    "prismjs": "^1.29.0",
    "strip-indent": "^3.0.0"
  },
  "engines": {
    "node": ">=22.1.0"
  },
  "resolutions": {
    "got": "11.8.2"
  }
}
