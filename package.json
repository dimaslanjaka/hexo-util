    "@types/rewire": "^2.5.30",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "c8": "^10.1.2",
    "chai": "^4.3.6",
    "domhandler": "^5.0.3",
    "eslint": "^9.32.0",
